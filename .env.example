# Docker Compose configuration. Copy to `.env`; every value is optional.
#   cp .env.example .env

# Groq API key for LLM-generated explanations. Free key from
# https://console.groq.com. If empty, a deterministic template is used and the
# system still works fully.
GROQ_API_KEY=

# Groq chat model. Default qwen/qwen3.8-27b. Override only if unavailable.
# GROQ_MODEL=qwen/qwen3.8-27b

# Caddy site address. ":80" serves on the raw host/IP over HTTP.
# Set to a domain (e.g. risk.example.com) for automatic HTTPS.
SITE_ADDRESS=:80
