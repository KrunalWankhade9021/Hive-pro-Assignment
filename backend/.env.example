# Backend configuration. Copy this file to `.env` and fill in your values.
# `.env` is gitignored; every setting has a sensible default, so the service
# runs without this file (explanations then use the deterministic template).

# Groq API key for LLM-generated risk explanations.
# Free key from https://console.groq.com. If unset, a deterministic template
# explanation is used instead (the system still works fully).
GROQ_API_KEY=

# Groq chat model used for explanations. Defaults to qwen/qwen3.8-27b.
# Override only if that model is unavailable on your account.
# GROQ_MODEL=qwen/qwen3.8-27b

# Comma-separated allowed CORS origins for the API. Defaults to "*".
# For a real deployment, set this to the frontend's origin, e.g.
# CORS_ORIGINS=https://your-domain.example
# CORS_ORIGINS=*

# Directory holding the built knowledge base (kev.parquet + chroma/).
# Defaults to backend/data. Override only if you build it elsewhere.
# DATA_DIR=

# Directory holding the CSV data pack. Defaults to the repo's Dataset/.
# DATASET_DIR=
